# Gộp các dòng này vào application.properties của bạn
spring.datasource.url=jdbc:mysql://localhost:3306/time_management?useSSL=false&serverTimezone=Asia/Ho_Chi_Minh
spring.datasource.username=root
spring.datasource.password=your_password
spring.jpa.hibernate.ddl-auto=update
spring.jackson.time-zone=Asia/Ho_Chi_Minh
# Để Spring trả kèm nội dung lỗi (thay cho thông báo chung chung)
server.error.include-message=always
